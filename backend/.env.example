# Mẫu cấu hình backend. Copy thành backend/.env rồi điền giá trị.
# File này được commit nên KHÔNG điền key thật ở đây.

# [Bắt buộc] API key Anthropic, dạng sk-ant-...
# Lấy ở https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# [Bắt buộc] Model ID cho các demo gọi Claude (từ Demo 02). Demo 01 không cần key.
# Chọn ở https://docs.claude.com/en/docs/about-claude/models
LLM_MODEL=

# [Tùy chọn] Override trần token — mặc định trong backend/llm_limits.py (4096 / 2048).
# LLM_MAX_TOKENS=4096
# LLM_OUTPUT_MAX_TOKENS=2048

# [Tùy chọn] Timeout (giây) cho một lần gọi Claude. Mặc định 30.
LLM_TIMEOUT_SECONDS=30

# [Tùy chọn] Demo 08: trần thời gian một run SDK (CLI có thể api_retry). Mặc định 180.
SDK_RUN_TIMEOUT_SECONDS=180
# [Tùy chọn] Demo 08: CLAUDE_CODE_MAX_RETRIES cho CLI (mặc định CLI là 10). Mặc định 0.
SDK_MAX_RETRIES=0
